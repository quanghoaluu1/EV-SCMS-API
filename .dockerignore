# ============================================================================
# Docker Ignore File
# ============================================================================
# Files and directories to exclude from Docker build context
# ============================================================================

# Git
.git/
.gitignore
.gitattributes

# IDE
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/

# Build artifacts
**/bin/
**/obj/
**/out/
**/publish/

# NuGet
*.nupkg
**/packages/
.nuget/

# Test results
**/TestResults/
**/*.trx

# Documentation
*.md
!README.md

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# Environment
.env
.env.*
env.example

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db
*.swp
*.swo

# Temporary files
*.tmp
*.temp
~$*
