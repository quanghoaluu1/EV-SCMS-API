# ============================================================================
# Docker Compose Override Example
# ============================================================================
#
# Copy this file to docker-compose.override.yml for custom configurations
# cp docker-compose.override.yml.example docker-compose.override.yml
#
# This file is useful for:
# - Development-specific configurations
# - Volume mounts for hot reload
# - Custom port mappings
# - Additional services
#
# ============================================================================

version: '3.8'

services:
  # Example: Mount source code for hot reload during development
  # chat-api:
  #   volumes:
  #     - ./Services/Chat/Chat.WebApi:/src/Services/Chat/Chat.WebApi
  #     - ./Services/Chat/Chat.Application:/src/Services/Chat/Chat.Application

  # Example: Change port mapping
  # auth-api:
  #   ports:
  #     - "9001:8080"  # Map to different host port

  # Example: Add custom environment variable
  # booking-api:
  #   environment:
  #     - CUSTOM_SETTING=value

